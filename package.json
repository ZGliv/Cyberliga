{
  "name": "cyberliga",
  "version": "0.1.0",
  "private": true,
  "description": "The autonomous Cyberliga sports world prototype.",
  "type": "module",
  "scripts": {
    "dev": "node server.mjs",
    "start": "node server.mjs",
    "test:api": "node --test api/canonical-server.test.mjs",
    "test:moments": "node --test athlete-moments.test.mjs",
    "test:named-moments": "node --test named-moments.test.mjs",
    "test:broadcast": "node --test broadcast-spine.test.mjs",
    "test:football-replay-memory": "node --test football-replay-memory.test.mjs",
    "test:basketball-brain": "node --test basketballbrain.test.mjs",
    "test:visuals": "node --test foundingvisual.test.mjs foundinglive.test.mjs",
    "verify": "npm run test:api && npm run test:moments && npm run test:named-moments && npm run test:broadcast && npm run test:football-replay-memory && npm run test:basketball-brain && npm run test:visuals && node scripts/verify.mjs",
    "release:check": "npm run verify && node scripts/release-check.mjs"
  },
  "engines": {
    "node": ">=18"
  }
}
